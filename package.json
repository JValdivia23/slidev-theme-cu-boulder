{
  "name": "slidev-theme-cu-boulder",
  "description": "Community Slidev theme inspired by University of Colorado Boulder branding",
  "version": "0.1.0",
  "author": {
    "name": "Jairo M. Valdivia",
    "url": "https://github.com/JValdivia23"
  },
  "homepage": "https://github.com/JValdivia23/slidev-theme-cu-boulder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JValdivia23/slidev-theme-cu-boulder.git"
  },
  "license": "MIT",
  "keywords": [
    "slidev",
    "slidev-theme",
    "slidev-theme-cu-boulder",
    "cu-boulder",
    "university-of-colorado",
    "academic",
    "atoc"
  ],
  "files": [
    "assets",
    "layouts",
    "styles",
    "components",
    "examples",
    "public",
    "setup",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "slidev example.md --open",
    "build": "slidev build example.md --base ./",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "engines": {
    "node": ">=22.12.0",
    "slidev": ">=0.48.0"
  },
  "dependencies": {
    "@slidev/types": "^53.0.0"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "manim-web": "^0.3.24"
  },
  "peerDependencies": {
    "manim-web": "^0.3.24"
  },
  "peerDependenciesMeta": {
    "manim-web": {
      "optional": true
    }
  },
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "sans": "Noto Sans",
        "serif": "Noto Serif",
        "mono": "Noto Sans Mono",
        "provider": "google"
      },
      "themeConfig": {
        "showLogo": true,
        "department": "Department of Atmospheric & Oceanic Sciences"
      }
    }
  },
  "overrides": {
    "floating-vue": "5.2.2"
  }
}
